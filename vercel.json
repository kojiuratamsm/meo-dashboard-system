{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "api/$1"
    }
  ],
  "functions": {
    "api/public/draft.js": {
      "maxDuration": 30
    }
  }
}
